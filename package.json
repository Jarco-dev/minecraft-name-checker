{
    "name": "typescript-template",
    "version": "1.2.0",
    "description": "A basic typescript project template",
    "main": "dist/index.js",
    "author": "Jarco-dev",
    "license": "MIT",
    "engines": {
        "node": "^22.13.0"
    },
    "scripts": {
        "start": "node dist/index.js",
        "dev": "tsx watch --clear-screen=false src/index.ts",
        "clean": "rimraf ./dist",
        "build": "npm run clean && tsc --build --force && tsc-alias",
        "type-check": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "dependencies": {
        "discord.js": "^14.25.1",
        "dotenv": "^18.0.9",
        "moment": "^2.31.0",
        "node-cron": "^4.6.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "@types/node-cron": "^3.0.11",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-perfectionist": "^5.13.0",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-yml": "^3.10.0",
        "globals": "^17.14.0",
        "prettier": "^3.9.10",
        "rimraf": "^6.1.4",
        "tsc-alias": "^1.9.10",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3"
    }
}
